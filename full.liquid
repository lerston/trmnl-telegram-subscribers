<div class="layout layout--col layout--stretch"><div class="flex flex--col flex--between w--full h--full">
  <div class="flex flex--row flex--between w--full">
    <div class="flex flex--col flex--left gap--small">
      <span class="title title--small" data-clamp="1">{{ channel_name | escape }}</span>
      <span class="description">@{{ channel | escape }}</span>
    </div>
    <span class="label">{% if status == 'ok' %}Public count{% else %}{{ status | capitalize }}{% endif %}</span>
  </div>
  <div class="grid grid--cols-4 portrait:grid--cols-2">
    <div class="item col--span-2"><div class="meta"></div><div class="content"><span class="value value--large lg:value--xlarge value--tnums">{{ subscribers_display }}</span><span class="label">Subscribers</span></div></div>
    <div class="item"><div class="meta"></div><div class="content"><span class="value lg:value--large value--tnums">{{ delta_day_display }}</span><span class="label">Past 24 hours</span></div></div>
    <div class="item"><div class="meta"></div><div class="content"><span class="value lg:value--large value--tnums">{{ delta_week_display }}</span><span class="label">Past 7 days</span></div></div>
  </div>
  {% if note != blank %}<span class="description">{{ note | escape }}</span>{% endif %}
  {% render "subscribers_chart", chart: chart, history_days: history_days %}
</div></div>
{% render "subscribers_footer", updated_display: updated_display %}
